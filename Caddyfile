# The web server in front, the official Caddy image: every request reaches it. The built pages, `/_astro/*`, the pictures
# and the 404 page are files in its own folder (`SITE_DIR`, kept equal to the shared folder by `scripts/sync.mjs`),
# without any logic of ours. Caddy answers each of them from that folder or with a 404 and never asks the API for one:
# the API would only answer what Caddy already knows, at the cost of a hop for every miss. Only what needs a request
# goes to the API (`scripts/start.mjs`, at `API_ADDRESS`): a POST (a posted form is answered at the page's own URL) and
# `/api/*`. No GET reaches it.
#
# `SITE_ADDRESS` is the address the site answers on. Behind a proxy that ends TLS: `http://<host>:<port>`, which keeps
# Caddy from asking for a certificate. Where Caddy ends TLS itself: the bare host name (`astro.example.com`), and it gets
# its certificate from Let's Encrypt. `CADDY_STORAGE` then belongs on a folder that every Caddy instance shares: they
# take turns asking for one certificate and all use it.
{
	admin off
	# A stopping pod finishes the requests it has; the platform keeps sending a few more for a moment after the signal.
	grace_period 10s
	storage file_system {$CADDY_STORAGE:/data}
	# The settings of Caddy ending TLS itself (`email`), which the operator provides; a Caddyfile cannot have an empty one.
	import /etc/caddy/tls/*
}

# The API: a pod that is just starting or stopping is tried again for a moment, on the next one.
(api) {
	reverse_proxy {$API_ADDRESS:127.0.0.1:3001} {
		lb_try_duration 3s
		lb_try_interval 250ms
	}
}

{$SITE_ADDRESS::3000} {
	encode zstd gzip

	# One URL per page: `/de` → `/de/` (a region's home page, the regions of `src/lib/i18n.ts`) and
	# `/de/shop/` → `/de/shop`, a foreign query string kept.
	@home path_regexp home ^/(de|uk|us)$
	redir @home /{re.home.1}/{?query} 301
	@slash {
		path_regexp slash ^(/.+?)/+$
		not path_regexp ^/(de|uk|us)/$
	}
	redir @slash {re.slash.1}{?query} 301

	# Never a file.
	handle /api/* {
		import api
	}

	# Only a GET or HEAD can be a file: a posted form is answered by the API, at the same URL.
	@read method GET HEAD
	handle @read {
		root * {$SITE_DIR:/site}

		# `/` has no file: it leads to the visitor's region. Only the first language tag counts: `de` gets German,
		# British English and its neighbours the `uk` region, anything else, or no header, `us`.
		@de header_regexp Accept-Language (?i)^\s*de
		@uk header_regexp Accept-Language (?i)^\s*en-(gb|ie|au|nz|za|in|sg)\b
		handle / {
			# The answer depends on this header, so a cache must keep one per value.
			header Vary Accept-Language
			redir @de /de/ 302
			redir @uk /uk/ 302
			redir * /us/ 302
		}

		# A picture's name is its content, so it never changes: the file is served for good. A picture that is not in
		# the folder yet (the builder makes it, the sync copies it) is a 404, never a request to the API.
		handle /media/* {
			@stored file
			handle @stored {
				header Cache-Control "public, max-age=31536000, immutable"
				file_server
			}

			# A scaled variant (`{md5}/{width}{ext}.webp`; SVG has none) that is missing is answered with the original
			# when that is there. It is another picture than the one named, so the browser asks again after 15 minutes.
			@variant {
				path_regexp v ^/media/([^/]+)/(?:400|800|1200|1600)(\.[a-z0-9]+)\.webp$
				not path *.svg.webp
			}
			handle @variant {
				@original file /media/{re.v.1}/original{re.v.2}
				handle @original {
					rewrite * /media/{re.v.1}/original{re.v.2}
					header Cache-Control "private, max-age=900"
					file_server
				}
				handle {
					respond "Not found" 404
				}
			}

			handle {
				respond "Not found" 404
			}
		}

		# Named by their content, so cached for good. Every build adds its own here, so an older page still finds its files.
		handle /_astro/* {
			root * {$SITE_DIR:/site}/assets
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		handle {
			root * {$SITE_DIR:/site}/current
			# A page may change with the next build: the browser asks again (ETag).
			@page not path_regexp \.\w+$
			header @page Cache-Control "no-cache"
			# The build's own report (`scripts/watch.mjs`) is always the latest.
			header /_build.json Cache-Control "no-cache"
			# `/de/shop` becomes the file `/de/shop/index.html` here, so the file server never redirects a folder to `/de/shop/`.
			try_files {path} {path}/index.html
			file_server
		}
	}

	handle {
		import api
	}

	# What is no file is the built 404 page, one for the whole site, with the status 404.
	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			root * {$SITE_DIR:/site}/current
			# Headers set before the error stay: a missing `/_astro` file would otherwise be cached as `immutable`.
			header Cache-Control "no-cache"
			rewrite * /404.html
			file_server
		}
	}
}
