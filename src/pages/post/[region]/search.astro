---
// A search form, or the range form of the results (which carries `q` along), posted to `/{region}/search`.
export const prerender = false;
import SearchView from "../../../components/SearchView.astro";
import { formOf, regionOf } from "../../../lib/request";
import { searchData } from "../../../lib/search";

const region = regionOf(Astro.params.region);
const form = await formOf(Astro.request);
if (!region) return Astro.rewrite("/404");
if (form instanceof Response) return form;
---
<SearchView data={await searchData(region, form)} />
