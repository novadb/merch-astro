---
// Renders a Visual Document (the page content); the slot (the live range) goes right after its first component, the hero.
import { firstImage, type ContentCtx } from "../lib/content";
import type { VNode } from "../lib/site";
import ContentNode from "./ContentNode.astro";

interface Props { node?: VNode; ctx: ContentCtx }
const { node, ctx: documentCtx } = Astro.props;
const ctx = { ...documentCtx, firstImage: node && firstImage(node, documentCtx.images) };
const [first, ...rest] = node?.children ?? [];
const Tag = (node?.element || "div") as "div"; // the CMS names the element; typed as one so that its attributes check
---
{node ? (
  // The root node (`merchComponentRoot`) comes from the CMS as `<div class="main">`: the `.main` of site.css.
  <Tag class={node.class}>
    {first && <ContentNode node={first} ctx={ctx} />}
    <slot />
    {rest.map((child) => <ContentNode node={child} ctx={ctx} />)}
  </Tag>
) : <slot />}
