---
// The product page: PIM data (price per market, stock, specs) plus similar products.
import type { Ctx } from "../lib/content";
import { formatPrice } from "../lib/i18n";
import { srcSet } from "../lib/images";
import type { Product } from "../lib/products";
import { PRODUCT_SIZES } from "../lib/sizes";
import ProductCard from "./ProductCard.astro";

interface Props { ctx: Ctx; product: Product; groupName?: string; similar: Product[] }
const { ctx, product: p, groupName, similar } = Astro.props;
const { text, region } = ctx;
const specs: [string, string][] = [
  [text.sku, p.sku ?? ""],
  [text.colour, p.color ? text.value(p.color) : ""],
  [text.material, p.materials.map(text.value).join(", ")],
  [text.volume, p.volume ? `${p.volume} ml` : ""],
  [text.screenSize, p.screenSize ? `${p.screenSize}″` : ""],
  [text.finish, p.finishes.map(text.value).join(", ")],
  [text.pieces, p.pieces ? text.pieceCount(p.pieces) : ""],
];
---
<article class="pdp">
  <div class="pdp__media">
    {p.image && <img src={p.image.src} srcset={srcSet(p.image.src)} sizes={PRODUCT_SIZES} alt={p.name} width={400} height={400} />}
  </div>
  <div class="pdp__info">
    {groupName && <p class="merchKicker">{groupName}</p>}
    <h1 class="pdp__name">{p.name}</h1>
    <p class="pdp__price">
      {formatPrice(p.price, ctx.market, region)}
      <span class={p.inStock === false ? "badge badge--muted" : "badge"}>{p.inStock === false ? text.soldOut : text.available}</span>
    </p>
    {p.shopifyId && p.inStock !== false && <div class="pdp__buy" data-shopify-product={p.shopifyId}></div>}
    {p.descriptionHtml && <div class="pdp__description" set:html={p.descriptionHtml} />}
    <dl class="specs">
      {specs.filter(([, value]) => value).map(([name, value]) => (
        <div>
          <dt>{name}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </div>
</article>
{similar.length > 0 && (
  <section class="merchBand">
    <h2 class="headline">{text.similar}</h2>
    <div class="grid">{similar.map((s) => <ProductCard product={s} ctx={ctx} />)}</div>
  </section>
)}
